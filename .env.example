SESSION_SECRET=
# true solo cuando el servidor corre detrás de HTTPS real — activa cookie
# Secure y la cabecera HSTS. En local sobre HTTP plano debe quedar en false.
FORZAR_HTTPS=false

DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/metrogest
# Superusuario de Postgres — solo se usa para crear/borrar la base temporal de
# verificación de respaldos (backup_db.py). No es la misma cuenta de la app.
POSTGRES_ADMIN_PASSWORD=
BACKUP_RETENCION_DIAS=30

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=MetroGest <contacto@metrogest.com.co>
EMAIL_DESTINATARIO=
