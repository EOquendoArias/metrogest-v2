SESSION_SECRET=
# true solo cuando el servidor corre detrás de HTTPS real — activa cookie
# Secure y la cabecera HSTS. En local sobre HTTP plano debe quedar en false.
FORZAR_HTTPS=false

DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/metrogest
# Superusuario de Postgres — solo se usa para crear/borrar la base temporal de
# verificación de respaldos (backup_db.py). No es la misma cuenta de la app.
POSTGRES_ADMIN_PASSWORD=
BACKUP_RETENCION_DIAS=30

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=MetroGest <contacto@metrogest.com.co>
EMAIL_DESTINATARIO=

# Procesos de Uvicorn (iniciar.bat). 1 = sin repartir carga entre procesos.
# Subir a 4+ requiere haber corrido configurar_tarea_windows.bat (ver README
# "Configurar la tarea diaria de alertas") y verificar RAM/max_connections
# de Postgres — ver docs/arquitectura/DECISIONES.md (ADR-001).
UVICORN_WORKERS=1
# Procesos dedicados a generar PDF/Excel (utils/pdf_executor.py), aparte de
# los workers de arriba. No suele hacer falta tocarlo.
PDF_EXECUTOR_WORKERS=2
